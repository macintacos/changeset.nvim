#!/usr/bin/env bash
#MISE description="Run the suite under luacov and print line coverage of lua/"
#MISE depends=["deps"]

set -euo pipefail

rm -rf .tests/luacov
mkdir -p .tests/luacov

# A spec nvim signalled inside vim.fn.system() hangs in exit teardown, deaf to SIGTERM,
# and outlives the run. || true: under set -e a no-match would become the exit status.
trap 'pkill -KILL -g 0 -f "PlenaryBustedDirectory|plenary[.]busted" || true' EXIT
trap 'exit 1' HUP INT TERM

# LUACOV is set from -c, after init, so only the spec processes, which inherit the
# environment, start luacov.
# sequential: every spec merges into one luacov stats file.
# Backgrounded: bash runs a trap only after its foreground child exits.
status=0
nvim --headless --noplugin -u tests/minimal_init.lua \
	-c "lua vim.env.LUACOV = '1'" \
	-c "PlenaryBustedDirectory tests/ {minimal_init = 'tests/minimal_init.lua', sequential = true}" &
wait $! || status=1

nvim -l tests/support/coverage.lua
# The report's Summary table is sized for absolute paths; reprint it repo-relative.
# index/substr, not sub(): root is a literal path, and sub reads it as a regex.
awk -v root="$PWD/" '/^Summary$/ { on = 1 } on && NF == 4 { if (index($1, root) == 1) $1 = substr($1, length(root) + 1); printf "%-40s %6s %6s %9s\n", $1, $2, $3, $4 }' \
	.tests/luacov/report.out
echo "Full report: .tests/luacov/report.out"
exit "$status"
