#!/usr/bin/env bash
#MISE description="Type-check the Lua with emmylua_check (config in .emmyrc.json and tests/.emmyrc.json)"
#MISE depends=["deps"]

set -euo pipefail

# Both configs resolve `$VIMRUNTIME` from the environment, which only a
# running nvim sets.
VIMRUNTIME="$(nvim --clean --headless --cmd 'lua io.write(vim.env.VIMRUNTIME)' --cmd 'qa!')"
export VIMRUNTIME

# Two workspaces, as `assert` is Lua's built-in in lua/ and plugin/ but luassert
# in tests/. Without --warnings-as-errors, a run with only warnings exits 0.
status=0
emmylua_check . --warnings-as-errors || status=1
emmylua_check tests --warnings-as-errors || status=1
exit "$status"
